@app.route('/item/<sku>')
def item_detail(sku):
    conn = None
    cur = None
    item = None
    movements = []
    try:
        conn = get_conn()
        try:
            cur = conn.cursor(dictionary=True)
        except Exception:
            cur = conn.cursor()

        cur.execute("""
            SELECT sku, name, unit, category, COALESCE(reorder_level, %s) AS reorder_level
            FROM items WHERE sku = %s
        """, (LOW_STOCK_THRESHOLD, sku))
